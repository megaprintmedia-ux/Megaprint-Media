        "supplierInvoiceId": { "type": "string", "maxLength": 128 },
        "supplierInvoiceNo": { "type": "string", "maxLength": 80 },
        "jobId": { "type": "string", "maxLength": 128 },
        "jobNumber": { "type": "string", "maxLength": 40 },
        "receivedDate": { "type": "string", "minLength": 1, "maxLength": 32 },
        "receivedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "conditionStatus": { "type": "string", "enum": ["Accepted", "Partial / Short", "Damaged / Rejected"] },
        "items": { "type": "array" },
        "totalValue": { "type": "number" },
        "postToInventory": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["grnNumber", "supplierName", "receivedDate", "receivedByName", "conditionStatus", "items", "totalValue", "postToInventory", "ownerUid", "staffUids", "createdAt", "updatedAt"]
    },
    "CashBookEntry": {
      "title": "Cash Book Transaction",
      "description": "Cash, EcoCash, petty cash, and bank ledger entry with running balance and reconciliation",
      "type": "object",
      "properties": {
        "entryNumber": { "type": "string", "minLength": 3, "maxLength": 40 },
        "entryDate": { "type": "string", "minLength": 1, "maxLength": 32 },
        "entryType": { "type": "string", "enum": ["Receipt (Inflow)", "Payment (Outflow)", "Contra / Transfer"] },
        "account": { "type": "string", "minLength": 1, "maxLength": 120 },
        "counterparty": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Customer Receipt", "Supplier Payment", "Wages & Casuals", "Sales Commission", "Transport & Fuel", "Workshop Petty Cash", "Bank Deposit / Transfer", "Other Operating"] },
        "reference": { "type": "string", "maxLength": 120 },
        "linkedDocRef": { "type": "string", "maxLength": 80 },
        "amount": { "type": "number" },
        "reconciled": { "type": "boolean" },
        "recordedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 500 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "viewerUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["entryNumber", "entryDate", "entryType", "account", "counterparty", "category", "amount", "reconciled", "recordedByName", "ownerUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "ChartAccount": {
      "title": "Chart of Accounts Entry",
      "description": "Editable bank, mobile money, cash, asset, liability, equity, revenue, and expense ledger account",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 24 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accountType": { "type": "string", "enum": ["Asset", "Liability", "Equity", "Revenue", "Expense"] },
        "subType": { "type": "string", "enum": ["Bank", "Mobile Money", "Cash", "Receivable", "Payable", "Tax / VAT", "Operating", "COGS", "Payroll"] },
        "currency": { "type": "string", "minLength": 3, "maxLength": 6 },
        "bankName": { "type": "string", "maxLength": 120 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "branch": { "type": "string", "maxLength": 120 },
        "openingBalance": { "type": "number" },
        "isCashBookAccount": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "accountType", "subType", "currency", "openingBalance", "isCashBookAccount", "isActive", "ownerUid", "staffUids", "createdAt", "updatedAt"]
    },
    "UserInvite": {
      "title": "Staff Access Invite",
      "description": "Pre-authorized staff invitation created by the owner/management so team members can sign in immediately",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["management", "sales", "accounts", "production"] },
        "department": { "type": "string", "enum": ["Management", "Sales & Marketing", "Accounts", "Production"] },
        "commissionRatePct": { "type": "number" },
        "status": { "type": "string", "enum": ["invited", "accepted", "revoked"] },
        "invitedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "acceptedUid": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "department", "commissionRatePct", "status", "invitedByName", "ownerUid", "adminUids", "createdAt", "updatedAt"]
    }
  },
