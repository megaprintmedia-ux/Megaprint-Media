        isNonEmptyStr(data.displayName, 120) &&
        data.role in ['management', 'sales', 'accounts', 'production'] &&
        data.department in ['Management', 'Sales & Marketing', 'Accounts', 'Production'] &&
        (!('taxScope' in data) || data.taxScope in ['all', 'vat_only']) &&
        data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 50 &&
        data.status in ['invited', 'accepted', 'revoked'] &&
        isNonEmptyStr(data.invitedByName, 120) &&
        (!('acceptedUid' in data) || isOptionalStr(data.acceptedUid, 128)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.adminUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRequisition(data) {
      return data.keys().hasAll([
          'requisitionNumber', 'requisitionDate', 'requisitionType', 'department',
          'priority', 'requestedByUid', 'requestedByName', 'lines',
          'totalEstimatedCost', 'status', 'ownerUid', 'staffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requisitionNumber', 'requisitionDate', 'neededByDate', 'requisitionType',
          'department', 'priority', 'jobId', 'jobNumber', 'preferredSupplier',
          'requestedByUid', 'requestedByName', 'lines', 'totalEstimatedCost',
          'justification', 'status', 'approvedByName', 'approvedDate',
          'fulfillmentNotes', 'linkedRef', 'ownerUid', 'staffUids',
          'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.requisitionNumber, 40) &&
        isNonEmptyStr(data.requisitionDate, 32) &&
        (!('neededByDate' in data) || isOptionalStr(data.neededByDate, 32)) &&
        data.requisitionType in ['Purchase Requisition', 'Stock / Material Issue', 'Petty Cash / Expense'] &&
        data.department in ['Management', 'Sales & Marketing', 'Accounts', 'Production'] &&
        data.priority in ['Normal', 'Urgent', 'Critical'] &&
        (!('jobId' in data) || isOptionalStr(data.jobId, 128)) &&
        (!('jobNumber' in data) || isOptionalStr(data.jobNumber, 40)) &&
        (!('preferredSupplier' in data) || isOptionalStr(data.preferredSupplier, 160)) &&
        isValidId(data.requestedByUid) &&
        isNonEmptyStr(data.requestedByName, 120) &&
        data.lines is list && data.lines.size() >= 1 && data.lines.size() <= 10 && data.lines[0] is map &&
        isNonNegativeNum(data.totalEstimatedCost) &&
        (!('justification' in data) || isOptionalStr(data.justification, 1000)) &&
        data.status in ['Draft', 'Submitted', 'Approved', 'Rejected', 'Fulfilled'] &&
        (!('approvedByName' in data) || isOptionalStr(data.approvedByName, 120)) &&
        (!('approvedDate' in data) || isOptionalStr(data.approvedDate, 32)) &&
        (!('fulfillmentNotes' in data) || isOptionalStr(data.fulfillmentNotes, 500)) &&
        (!('linkedRef' in data) || isOptionalStr(data.linkedRef, 80)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.staffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Users (PII & Role Assignment)
    match /users/{userId} {
      allow get: if isVerifiedSignedIn() && isValidId(userId) && (request.auth.uid == userId || isManagement());
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.uid == request.auth.uid ||
        ('adminUids' in resource.data && resource.data.adminUids is list && resource.data.adminUids.size() <= 10 && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isBootstrappedAdmin() && request.auth.uid == userId) ||
          (
            request.auth.uid == userId &&
            'inviteId' in incoming() &&
            isValidId(incoming().inviteId) &&
            exists(/databases/$(database)/documents/userInvites/$(incoming().inviteId)) &&
            get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.status == 'invited' &&
            get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.email == request.auth.token.email.lower() &&
            incoming().role == get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.role &&
            incoming().department == get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.department &&
            (
              (!('taxScope' in get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data) && (!('taxScope' in incoming()) || incoming().taxScope == 'all')) ||
              ('taxScope' in get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data && incoming().taxScope == get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.taxScope)
            ) &&
            incoming().status == 'active'
          ) ||
          (request.auth.uid == userId && incoming().role == 'sales' && incoming().status == 'pending' && (!('taxScope' in incoming()) || incoming().taxScope == 'all'))
        );
      allow update: if isVerifiedSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isManagement() && isValidId(userId);
    }

    // 2. Company Settings
    match /companySettings/{settingId} {
      allow get: if isVerifiedSignedIn() && isValidId(settingId) && isActiveStaff();
      allow list: if isVerifiedSignedIn() && (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isManagement() &&
        isValidId(settingId) &&
        isValidCompanySettings(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isManagement() &&
        isValidId(settingId) &&
        isValidCompanySettings(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 3. Clients CRM
    match /clients/{clientId} {
      allow get: if isVerifiedSignedIn() && isValidId(clientId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isSalesOrManagement() || isAccountsOrManagement());
      allow update: if isVerifiedSignedIn() &&
        isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          ((isSalesOrManagement() || isAccountsOrManagement()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName', 'contactName', 'email', 'phone', 'taxPin',
              'zimraTin', 'vatRegNumber', 'isVatRegistered',
              'address', 'paymentTermsDays', 'notes', 'staffUids', 'updatedAt'
            ])
          )
        );
      allow delete: if isManagement() && isValidId(clientId);
    }

    // 4. Jobs & Job Cards
    match /jobs/{jobId} {
      allow get: if isVerifiedSignedIn() && isValidId(jobId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(jobId) &&
        isValidJob(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
        isSalesOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(jobId) &&
        isValidJob(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().status != 'Cancelled' &&
            isAccountsOrManagement() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'actualCostTotal', 'commissionRatePct', 'commissionBasis',
              'commissionAmount', 'commissionStatus', 'commissionPaidDate', 'updatedAt'
            ])
          ) ||
          (
            !(existing().status in ['Completed', 'Cancelled']) &&
            (
              (isProductionOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'checklist', 'artworkNotes', 'tailoringMeasurements',
                'actualCostTotal', 'assignedProductionName', 'updatedAt'
              ])) ||
              (isSalesOrManagement() && existing().status in ['Quoted', 'Approved'] && incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'category', 'status', 'priority', 'dueDate', 'printMethod',
                'substrateOrFabric', 'colorSpecs', 'quantity', 'sizeBreakdown',
                'artworkNotes', 'tailoringMeasurements', 'pricingMode', 'vatTreatment',
                'vatRate', 'unitPrice', 'netTotal', 'vatAmount', 'grossTotal',
                'estimatedMaterialCost', 'estimatedLaborCost', 'estimatedSubcontractCost',
                'estimatedOverheadCost', 'assignedSalesUid', 'assignedSalesName',
                'commissionRatePct', 'commissionBasis', 'commissionAmount', 'updatedAt'
              ]))
            )
          )
        );
      allow delete: if isManagement() && isValidId(jobId);

      // 4a. Job Cost Entries Subcollection (Master Gate)
      match /costs/{costId} {
        allow get: if isVerifiedSignedIn() && isValidId(jobId) && isValidId(costId) &&
          exists(/databases/$(database)/documents/jobs/$(jobId)) && isFullActiveStaff();
        allow list: if isVerifiedSignedIn() && isValidId(jobId) && (
          isBootstrappedAdmin() ||
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
        );
        allow create: if isVerifiedSignedIn() &&
          isValidId(jobId) &&
          isValidId(costId) &&
          isValidJobCost(incoming(), jobId) &&
          incoming().ownerUid == request.auth.uid &&
          request.auth.uid in incoming().staffUids &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/jobs/$(jobId)) &&
          (isProductionOrManagement() || isAccountsOrManagement());
        allow update: if false;
        allow delete: if isManagement() && isValidId(jobId) && isValidId(costId);
      }
    }

    // 5. Invoices (VAT & Receivables)
    match /invoices/{invoiceId} {
      allow get: if isVerifiedSignedIn() && isValidId(invoiceId) && (
        isFullActiveStaff() ||
        (isVatAuditorOnly() && ('isVatReportable' in existing() && existing().isVatReportable == true) && existing().vatAmount > 0)
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids) ||
        ('vatViewerUids' in resource.data && resource.data.vatViewerUids is list && resource.data.vatViewerUids.size() <= 10 && request.auth.uid in resource.data.vatViewerUids && ('isVatReportable' in resource.data && resource.data.isVatReportable == true) && resource.data.vatAmount > 0)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(invoiceId) &&
        isValidInvoice(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
        (isAccountsOrManagement() || isSalesOrManagement());
      allow update: if isVerifiedSignedIn() &&
        isValidId(invoiceId) &&
        isValidInvoice(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().status != 'Void' &&
            isAccountsOrManagement() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'amountPaid', 'balanceDue', 'paymentMethod',
              'paymentReference', 'whtRate', 'whtWithheldAmount',
              'whtCertificateRef', 'notes', 'dueDate', 'isVatReportable',
              'vatViewerUids', 'updatedAt'
            ])
          )
        );
      allow delete: if isManagement() && isValidId(invoiceId);
    }

    // 6. Expenses (Input VAT & Payables)
    match /expenses/{expenseId} {
      allow get: if isVerifiedSignedIn() && isValidId(expenseId) && (
        isAccountsOrManagement() ||
        isBootstrappedAdmin() ||
        (isVatAuditorOnly() && ('isVatReportable' in existing() && existing().isVatReportable == true) && existing().isVatClaimable == true && existing().vatAmount > 0)
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids) ||
        ('vatViewerUids' in resource.data && resource.data.vatViewerUids is list && resource.data.vatViewerUids.size() <= 10 && request.auth.uid in resource.data.vatViewerUids && ('isVatReportable' in resource.data && resource.data.isVatReportable == true) && resource.data.isVatClaimable == true && resource.data.vatAmount > 0)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(expenseId) &&
        isValidExpense(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(expenseId) &&
        isValidExpense(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
            'paymentStatus', 'vendorVatPin', 'vendorTin', 'vendorVatReg',
            'vendorInvoiceRef', 'vatTreatment', 'isVatClaimable', 'notes',
            'isVatReportable', 'vatViewerUids', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(expenseId);
    }

    // 7. Employees (HR Directory - PII & Salary Protected)
    match /employees/{employeeId} {
      allow get: if isVerifiedSignedIn() && isValidId(employeeId) && (
        isAccountsOrManagement() ||
        existing().userUid == request.auth.uid ||
        existing().ownerUid == request.auth.uid
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.userUid == request.auth.uid ||
        (resource.data.hrViewerUids is list && resource.data.hrViewerUids.size() <= 10 && request.auth.uid in resource.data.hrViewerUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(employeeId) &&
        isValidEmployee(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().hrViewerUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(employeeId) &&
        isValidEmployee(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'email', 'phone', 'department', 'jobTitle', 'employmentType',
            'hourlyRate', 'monthlySalary', 'taxDeductionRate', 'annualLeaveBalance',
            'sickLeaveBalance', 'status', 'userUid', 'hrViewerUids', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(employeeId);
    }

    // 8. Time Entries (Time Tracking)
    match /timeEntries/{entryId} {
      allow get: if isVerifiedSignedIn() && isValidId(entryId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(entryId) &&
        isValidTimeEntry(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(entryId) &&
        isValidTimeEntry(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().status != 'Approved' &&
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clockOutIso', 'breakMinutes', 'regularHours', 'overtimeHours',
              'totalHours', 'laborCost', 'status', 'notes', 'jobId', 'jobNumber', 'updatedAt'
            ]) &&
            incoming().status in ['Clocked In', 'Completed']
          ) ||
          (
            isAccountsOrManagement() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isManagement() && isValidId(entryId);
    }

    // 9. Leave Requests
    match /leaveRequests/{requestId} {
      allow get: if isVerifiedSignedIn() && isValidId(requestId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(requestId) &&
        isValidLeaveRequest(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().status == 'Pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(requestId) &&
        isValidLeaveRequest(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().status == 'Pending' &&
            isAccountsOrManagement() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByName', 'updatedAt'])
          )
        );
      allow delete: if isManagement() && isValidId(requestId);
    }

    // 10. Payroll Runs
    match /payrollRuns/{runId} {
      allow get: if isVerifiedSignedIn() && isValidId(runId) && isAccountsOrManagement();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.hrViewerUids is list && resource.data.hrViewerUids.size() <= 10 && request.auth.uid in resource.data.hrViewerUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(runId) &&
        isValidPayrollRun(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().hrViewerUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(runId) &&
        isValidPayrollRun(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (existing().status != 'Paid' && isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']))
        );
      allow delete: if isManagement() && isValidId(runId);
    }

    // 11. Operational Sticky Notes (Manager Reminders)
    match /notes/{noteId} {
      allow get: if isVerifiedSignedIn() && isValidId(noteId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(noteId) &&
        isValidNote(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(noteId) &&
        isValidNote(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isManagement();
      allow delete: if isManagement() && isValidId(noteId);
    }

    // 12. Supplier Tax Invoices (Input VAT & Accounts Payable)
    match /supplierInvoices/{supplierInvoiceId} {
      allow get: if isVerifiedSignedIn() && isValidId(supplierInvoiceId) && (
        isAccountsOrManagement() ||
        isBootstrappedAdmin() ||
        (isVatAuditorOnly() && ('isVatReportable' in existing() && existing().isVatReportable == true) && existing().isVatClaimable == true && existing().vatAmount > 0)
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.viewerUids is list && resource.data.viewerUids.size() <= 10 && request.auth.uid in resource.data.viewerUids) ||
        ('vatViewerUids' in resource.data && resource.data.vatViewerUids is list && resource.data.vatViewerUids.size() <= 10 && request.auth.uid in resource.data.vatViewerUids && ('isVatReportable' in resource.data && resource.data.isVatReportable == true) && resource.data.isVatClaimable == true && resource.data.vatAmount > 0)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(supplierInvoiceId) &&
        isValidSupplierInvoice(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().viewerUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(supplierInvoiceId) &&
        isValidSupplierInvoice(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'amountPaid', 'balanceDue', 'paymentMethod',
            'paymentReference', 'supplierTaxPin', 'supplierTin', 'supplierVatReg',
            'isVatRegistered', 'isVatClaimable', 'whtApplicable', 'whtRate',
            'whtAmount', 'whtRemitted', 'notes', 'dueDate', 'isVatReportable',
            'vatViewerUids', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(supplierInvoiceId);
    }

    // 13. Inventory & Samples
    match /inventoryItems/{itemId} {
      allow get: if isVerifiedSignedIn() && isValidId(itemId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(itemId) &&
        isValidInventoryItem(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(itemId) &&
        isValidInventoryItem(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isFullActiveStaff() && incoming().diff(existing()).affectedKeys().hasOnly([
            'quantityOnHand', 'status', 'location', 'sampleClientOrSpec',
            'notes', 'reorderLevel', 'unitCost', 'supplierName', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(itemId);

      // 13a. Inventory Stock Movements Subcollection (Master Gate)
      match /movements/{movementId} {
        allow get: if isVerifiedSignedIn() && isValidId(itemId) && isValidId(movementId) &&
          exists(/databases/$(database)/documents/inventoryItems/$(itemId)) && isFullActiveStaff();
        allow list: if isVerifiedSignedIn() && isValidId(itemId) && (
          isBootstrappedAdmin() ||
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
        );
        allow create: if isVerifiedSignedIn() &&
          isValidId(itemId) &&
          isValidId(movementId) &&
          isValidInventoryMovement(incoming(), itemId) &&
          incoming().ownerUid == request.auth.uid &&
          request.auth.uid in incoming().staffUids &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/inventoryItems/$(itemId)) &&
          isFullActiveStaff();
        allow update: if false;
        allow delete: if isManagement() && isValidId(itemId) && isValidId(movementId);
      }
    }

    // 14. Goods Received Notes (GRN)
    match /goodsReceipts/{grnId} {
      allow get: if isVerifiedSignedIn() && isValidId(grnId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(grnId) &&
        isValidGoodsReceipt(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(grnId) &&
        isValidGoodsReceipt(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            (isAccountsOrManagement() || isProductionOrManagement()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'conditionStatus', 'supplierInvoiceId', 'supplierInvoiceNo', 'notes', 'updatedAt'
            ])
          )
        );
      allow delete: if isManagement() && isValidId(grnId);
    }

    // 15. Cash Book Ledger (Management & Accounts)
    match /cashBookEntries/{entryId} {
      allow get: if isVerifiedSignedIn() && isValidId(entryId) && (isAccountsOrManagement() || isBootstrappedAdmin());
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.viewerUids is list && resource.data.viewerUids.size() <= 10 && request.auth.uid in resource.data.viewerUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(entryId) &&
        isValidCashBookEntry(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().viewerUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(entryId) &&
        isValidCashBookEntry(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
            'reconciled', 'reference', 'linkedDocRef', 'notes', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(entryId);
    }

    // 16. Chart of Accounts (Editable Banks, Mobile Money, Cash & Ledger Accounts)
    match /chartOfAccounts/{accountId} {
      allow get: if isVerifiedSignedIn() && isValidId(accountId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(accountId) &&
        isValidChartAccount(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAccountsOrManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(accountId) &&
        isValidChartAccount(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (isAccountsOrManagement() && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'accountType', 'subType', 'currency',
            'bankName', 'accountNumber', 'branch', 'openingBalance',
            'isCashBookAccount', 'isActive', 'notes', 'staffUids', 'updatedAt'
          ]))
        );
      allow delete: if isManagement() && isValidId(accountId);
    }

    // 17. Pre-Authorized User Invites (Owner Onboarding)
    match /userInvites/{inviteId} {
      allow get: if isVerifiedSignedIn() && isValidId(inviteId) && (
        isManagement() ||
        existing().email == request.auth.token.email.lower()
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        ('adminUids' in resource.data && resource.data.adminUids is list && resource.data.adminUids.size() <= 10 && request.auth.uid in resource.data.adminUids) ||
        resource.data.email == request.auth.token.email.lower()
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(inviteId) &&
        isValidUserInvite(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().adminUids &&
        incoming().status == 'invited' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isManagement();
      allow update: if isVerifiedSignedIn() &&
        isValidId(inviteId) &&
        isValidUserInvite(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().status == 'invited' &&
            existing().email == request.auth.token.email.lower() &&
            incoming().status == 'accepted' &&
            incoming().acceptedUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedUid', 'updatedAt'])
          )
        );
      allow delete: if isManagement() && isValidId(inviteId);
    }

    // 18. Internal Requisitions (Purchase, Material Issue & Petty Cash)
    match /requisitions/{requisitionId} {
      allow get: if isVerifiedSignedIn() && isValidId(requisitionId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(requisitionId) &&
        isValidRequisition(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().requestedByUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().status in ['Draft', 'Submitted'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(requisitionId) &&
        isValidRequisition(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          (
            existing().ownerUid == request.auth.uid &&
            existing().status in ['Draft', 'Submitted'] &&
            incoming().status in ['Draft', 'Submitted'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'requisitionDate', 'neededByDate', 'requisitionType', 'department',
              'priority', 'jobId', 'jobNumber', 'preferredSupplier', 'lines',
              'totalEstimatedCost', 'justification', 'status', 'updatedAt'
            ])
          ) ||
          (
            isAccountsOrManagement() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'approvedByName', 'approvedDate', 'fulfillmentNotes',
              'linkedRef', 'updatedAt'
            ])
          ) ||
          (
            isProductionOrManagement() &&
            existing().requisitionType == 'Stock / Material Issue' &&
            existing().status == 'Approved' &&
            incoming().status == 'Fulfilled' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'fulfillmentNotes', 'linkedRef', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedSignedIn() && isValidId(requisitionId) && (
        isManagement() ||
        (existing().ownerUid == request.auth.uid && existing().status == 'Draft')
      );
    }

    // 19. Suppliers Master Register
    match /suppliers/{supplierId} {
      allow get: if isVerifiedSignedIn() && isValidId(supplierId) && isFullActiveStaff();
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.staffUids is list && resource.data.staffUids.size() <= 10 && request.auth.uid in resource.data.staffUids)
      );
      allow create: if isVerifiedSignedIn() &&
        isValidId(supplierId) &&
        isValidSupplier(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().staffUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFullActiveStaff();
      allow update: if isVerifiedSignedIn() &&
        isValidId(supplierId) &&
        isValidSupplier(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isManagement() ||
          ((isAccountsOrManagement() || isProductionOrManagement()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'contactName', 'phone', 'email', 'address',
              'zimraTin', 'vatRegNumber', 'isVatRegistered', 'notes',
              'staffUids', 'updatedAt'
            ])
          )
        );
      allow delete: if isManagement() && isValidId(supplierId);
    }

    // 20. Historical Opening Balances (Excluded from VAT-Only Auditors)
    match /openingBalances/{recordId} {
      allow get: if isVerifiedSignedIn() && isValidId(recordId) && (
        isAccountsOrManagement() ||
        (isSalesOrManagement() && existing().recordType in ['receivable', 'customer_credit'])
      );
      allow list: if isVerifiedSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        ('viewerUids' in resource.data && resource.data.viewerUids is list && resource.data.viewerUids.size() <= 10 && request.auth.uid in resource.data.viewerUids)
      );
      allow create: if isManagement() &&
        isValidId(recordId) &&
        isValidOpeningBalanceRecord(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().viewerUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isManagement() &&
        isValidId(recordId) &&
        isValidOpeningBalanceRecord(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isManagement() && isValidId(recordId);
    }

    // 21. Legacy Data Import Runs & Audit Snapshots (Strictly Management-Only)
    match /migrationRuns/{runId} {
      allow get: if isManagement() && isValidId(runId);
      allow list: if isManagement() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        ('adminUids' in resource.data && resource.data.adminUids is list && resource.data.adminUids.size() <= 10 && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isManagement() &&
        isValidId(runId) &&
        isValidMigrationRun(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        request.auth.uid in incoming().adminUids &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isManagement() &&
        isValidId(runId) &&
        isValidMigrationRun(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isManagement() && isValidId(runId);

      match /records/{recordId} {
        allow get: if isManagement() && isValidId(runId) && isValidId(recordId) &&
          exists(/databases/$(database)/documents/migrationRuns/$(runId));
        allow list: if isManagement() && isValidId(runId) && (
          isBootstrappedAdmin() ||
          resource.data.ownerUid == request.auth.uid ||
          ('adminUids' in resource.data && resource.data.adminUids is list && resource.data.adminUids.size() <= 10 && request.auth.uid in resource.data.adminUids)
        );
        allow create: if isManagement() &&
          isValidId(runId) &&
          isValidId(recordId) &&
          isValidMigrationRunRecord(incoming(), runId) &&
          incoming().ownerUid == request.auth.uid &&
          request.auth.uid in incoming().adminUids &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/migrationRuns/$(runId));
        allow update: if isManagement() &&
          isValidId(runId) &&
          isValidId(recordId) &&
          isValidMigrationRunRecord(incoming(), runId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedAt == request.time;
        allow delete: if isManagement() && isValidId(runId) && isValidId(recordId);
      }

      match /tables/{tableId} {
        allow get: if isManagement() && isValidId(runId) && isValidId(tableId) &&
          exists(/databases/$(database)/documents/migrationRuns/$(runId));
        allow list: if isManagement() && isValidId(runId) && (
          isBootstrappedAdmin() ||
          resource.data.ownerUid == request.auth.uid ||
          ('adminUids' in resource.data && resource.data.adminUids is list && resource.data.adminUids.size() <= 10 && request.auth.uid in resource.data.adminUids)
        );
        allow create: if isManagement() &&
          isValidId(runId) &&
          isValidId(tableId) &&
          isValidMigrationReferenceTable(incoming(), runId) &&
          incoming().ownerUid == request.auth.uid &&
          request.auth.uid in incoming().adminUids &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/migrationRuns/$(runId));
        allow update: if false;
        allow delete: if isManagement() && isValidId(runId) && isValidId(tableId);
      }
    }
  }
}
