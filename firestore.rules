rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonNegativeNum(val) {
      return val is number && val >= 0;
    }

    function isFiniteNum(val) {
      return val is number && val >= -1000000000000 && val <= 1000000000000;
    }

    function isBoundedUidList(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 10 && arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 128;
    }

    function isOptionalBoundedUidList(arr) {
      return arr is list && arr.size() <= 10 && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 128));
    }

    function isBootstrappedAdmin() {
      return isVerifiedSignedIn() && request.auth.token.email.lower() == 'megaprintmedia@gmail.com';
    }

    function userDocExists() {
      return isVerifiedSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVatAuditorOnly() {
      return userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role == 'accounts' &&
        ('taxScope' in userDoc() && userDoc().taxScope == 'vat_only');
    }

    function isActiveStaff() {
      return isBootstrappedAdmin() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role in ['management', 'sales', 'accounts', 'production']
      );
    }

    function isFullActiveStaff() {
      return isBootstrappedAdmin() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role in ['management', 'sales', 'accounts', 'production'] &&
        !('taxScope' in userDoc() && userDoc().taxScope == 'vat_only')
      );
    }

    function isManagement() {
      return isBootstrappedAdmin() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role == 'management'
      );
    }

    function isAccountsOrManagement() {
      return isManagement() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role == 'accounts' &&
        !('taxScope' in userDoc() && userDoc().taxScope == 'vat_only')
      );
    }

    function isSalesOrManagement() {
      return isManagement() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role == 'sales'
      );
    }

    function isProductionOrManagement() {
      return isManagement() || (
        userDocExists() &&
        userDoc().status == 'active' &&
        userDoc().role == 'production'
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validators (No existing() or diff() inside validators)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'department', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'department', 'status', 'taxScope', 'commissionRatePct', 'inviteId', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        isNonEmptyStr(data.email, 200) &&
        isNonEmptyStr(data.displayName, 120) &&
        data.role in ['management', 'sales', 'accounts', 'production'] &&
        data.department in ['Management', 'Sales & Marketing', 'Accounts', 'Production'] &&
        data.status in ['active', 'pending', 'disabled'] &&
        (!('taxScope' in data) || data.taxScope in ['all', 'vat_only']) &&
        (!('commissionRatePct' in data) || (data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 50)) &&
        (!('inviteId' in data) || isOptionalStr(data.inviteId, 128)) &&
        (!('adminUids' in data) || isBoundedUidList(data.adminUids)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['companyName', 'currency', 'defaultVatRate', 'ownerUid', 'updatedAt']) &&
        data.keys().hasOnly([
          'companyName', 'tagline', 'taxPin', 'zimraTin', 'vatRegNumber',
          'address', 'phone', 'email', 'currency', 'defaultVatRate',
          'defaultCommissionRatePct', 'defaultCommissionBasis', 'logoDataUrl',
          'ownerUid', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.companyName, 120) &&
        (!('tagline' in data) || isOptionalStr(data.tagline, 200)) &&
        (!('taxPin' in data) || isOptionalStr(data.taxPin, 64)) &&
        (!('zimraTin' in data) || isOptionalStr(data.zimraTin, 64)) &&
        (!('vatRegNumber' in data) || isOptionalStr(data.vatRegNumber, 64)) &&
        (!('address' in data) || isOptionalStr(data.address, 300)) &&
        (!('phone' in data) || isOptionalStr(data.phone, 40)) &&
        (!('email' in data) || isOptionalStr(data.email, 200)) &&
        isNonEmptyStr(data.currency, 6) &&
        data.defaultVatRate is number && data.defaultVatRate >= 0 && data.defaultVatRate <= 50 &&
        (!('defaultCommissionRatePct' in data) || (data.defaultCommissionRatePct is number && data.defaultCommissionRatePct >= 0 && data.defaultCommissionRatePct <= 50)) &&
        (!('defaultCommissionBasis' in data) || data.defaultCommissionBasis in ['net_sales', 'gross_profit']) &&
        (!('logoDataUrl' in data) || isOptionalStr(data.logoDataUrl, 200000)) &&
        isValidId(data.ownerUid) &&
        data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['companyName', 'paymentTermsDays', 'ownerUid', 'staffUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'companyName', 'contactName', 'email', 'phone', 'taxPin', 'zimraTin',
          'vatRegNumber', 'isVatRegistered', 'address', 'paymentTermsDays',
          'notes', 'legacySourceId', 'legacyPricingMode', 'creditApproved',
          'creditLimitUSD', 'importRunId', 'ownerUid', 'staffUids', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.companyName, 160) &&
        (!('contactName' in data) || isOptionalStr(data.contactName, 120)) &&
        (!('email' in data) || isOptionalStr(data.email, 200)) &&
        (!('phone' in data) || isOptionalStr(data.phone, 40)) &&
        (!('taxPin' in data) || isOptionalStr(data.taxPin, 64)) &&
        (!('zimraTin' in data) || isOptionalStr(data.zimraTin, 64)) &&
        (!('vatRegNumber' in data) || isOptionalStr(data.vatRegNumber, 64)) &&
        (!('isVatRegistered' in data) || data.isVatRegistered is bool) &&
        (!('address' in data) || isOptionalStr(data.address, 300)) &&
        data.paymentTermsDays is number && data.paymentTermsDays >= 0 && data.paymentTermsDays <= 365 &&
        (!('notes' in data) || isOptionalStr(data.notes, 1000)) &&
        (!('legacySourceId' in data) || isOptionalStr(data.legacySourceId, 128)) &&
        (!('legacyPricingMode' in data) || isOptionalStr(data.legacyPricingMode, 64)) &&
        (!('creditApproved' in data) || data.creditApproved is bool) &&
        (!('creditLimitUSD' in data) || isNonNegativeNum(data.creditLimitUSD)) &&
        (!('importRunId' in data) || isOptionalStr(data.importRunId, 128)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.staffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'staffUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'name', 'contactName', 'phone', 'email', 'address',
          'zimraTin', 'vatRegNumber', 'isVatRegistered', 'notes',
          'legacySourceKey', 'importRunId',
          'ownerUid', 'staffUids', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.name, 160) &&
        (!('contactName' in data) || isOptionalStr(data.contactName, 120)) &&
        (!('phone' in data) || isOptionalStr(data.phone, 40)) &&
        (!('email' in data) || isOptionalStr(data.email, 200)) &&
        (!('address' in data) || isOptionalStr(data.address, 300)) &&
        (!('zimraTin' in data) || isOptionalStr(data.zimraTin, 64)) &&
        (!('vatRegNumber' in data) || isOptionalStr(data.vatRegNumber, 64)) &&
        (!('isVatRegistered' in data) || data.isVatRegistered is bool) &&
        (!('notes' in data) || isOptionalStr(data.notes, 1000)) &&
        (!('legacySourceKey' in data) || isOptionalStr(data.legacySourceKey, 128)) &&
        (!('importRunId' in data) || isOptionalStr(data.importRunId, 128)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.staffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOpeningBalanceRecord(data) {
      return data.keys().hasAll([
          'recordType', 'sourceKey', 'sourceReference', 'counterpartyName',
          'outstandingUSD', 'isMatchedExisting', 'asOfDate', 'importRunId',
          'ownerUid', 'viewerUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'recordType', 'sourceKey', 'sourceReference', 'counterpartyId',
          'counterpartySourceId', 'counterpartyName', 'recordedDate', 'dueDate',
          'outstandingUSD', 'migrationTreatment', 'sourceStatus',
          'matchedSupplierInvoiceId', 'matchedSupplierInvoiceNo',
          'isMatchedExisting', 'notes', 'preservedMetadata',
          'asOfDate', 'importRunId', 'ownerUid', 'viewerUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.recordType in ['receivable', 'customer_credit', 'supplier_payable_invoice', 'supplier_opening_accrual'] &&
        isNonEmptyStr(data.sourceKey, 160) &&
        isNonEmptyStr(data.sourceReference, 120) &&
        (!('counterpartyId' in data) || isOptionalStr(data.counterpartyId, 128)) &&
        (!('counterpartySourceId' in data) || isOptionalStr(data.counterpartySourceId, 128)) &&
        isNonEmptyStr(data.counterpartyName, 160) &&
        (!('recordedDate' in data) || isOptionalStr(data.recordedDate, 32)) &&
        (!('dueDate' in data) || isOptionalStr(data.dueDate, 32)) &&
        isNonNegativeNum(data.outstandingUSD) &&
        (!('migrationTreatment' in data) || isOptionalStr(data.migrationTreatment, 200)) &&
        (!('sourceStatus' in data) || isOptionalStr(data.sourceStatus, 80)) &&
        (!('matchedSupplierInvoiceId' in data) || isOptionalStr(data.matchedSupplierInvoiceId, 128)) &&
        (!('matchedSupplierInvoiceNo' in data) || isOptionalStr(data.matchedSupplierInvoiceNo, 80)) &&
        data.isMatchedExisting is bool &&
        (!('notes' in data) || isOptionalStr(data.notes, 1000)) &&
        (!('preservedMetadata' in data) || (data.preservedMetadata is map && data.preservedMetadata.size() <= 20)) &&
        isNonEmptyStr(data.asOfDate, 32) &&
        isNonEmptyStr(data.importRunId, 128) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.viewerUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMigrationRun(data) {
      return data.keys().hasAll([
          'sourceSystem', 'targetSystem', 'asOfDate', 'payloadFingerprint',
          'status', 'executedByUid', 'executedByName', 'totalPlanned',
          'createdCount', 'matchedCount', 'skippedCount', 'failedCount',
          'controlsVerified', 'ownerUid', 'adminUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sourceSystem', 'targetSystem', 'asOfDate', 'payloadFingerprint',
          'status', 'executedByUid', 'executedByName', 'totalPlanned',
          'createdCount', 'matchedCount', 'skippedCount', 'failedCount',
          'grossReceivablesUSD', 'unappliedCreditsUSD', 'netReceivablesUSD',
          'importedPayablesUSD', 'matchedExistingPayablesUSD', 'accrualPayablesUSD',
          'totalSupplierPayablesUSD', 'trialBalanceDebitUSD', 'trialBalanceCreditUSD',
          'controlsVerified', 'systemUserReferences', 'alreadyCreatedInTargetCount',
          'constraintsCount', 'hasLiabilityBalancesTable', 'hasPayableLedgerTable',
          'failedKeys', 'lastError', 'ownerUid', 'adminUids', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.sourceSystem, 120) &&
        isNonEmptyStr(data.targetSystem, 120) &&
        isNonEmptyStr(data.asOfDate, 32) &&
        isNonEmptyStr(data.payloadFingerprint, 128) &&
        data.status in ['in_progress', 'completed', 'partial_failed'] &&
        isValidId(data.executedByUid) &&
        isNonEmptyStr(data.executedByName, 120) &&
        isNonNegativeNum(data.totalPlanned) &&
        isNonNegativeNum(data.createdCount) &&
        isNonNegativeNum(data.matchedCount) &&
        isNonNegativeNum(data.skippedCount) &&
        isNonNegativeNum(data.failedCount) &&
        (!('grossReceivablesUSD' in data) || isNonNegativeNum(data.grossReceivablesUSD)) &&
        (!('unappliedCreditsUSD' in data) || isNonNegativeNum(data.unappliedCreditsUSD)) &&
        (!('netReceivablesUSD' in data) || isFiniteNum(data.netReceivablesUSD)) &&
        (!('importedPayablesUSD' in data) || isNonNegativeNum(data.importedPayablesUSD)) &&
        (!('matchedExistingPayablesUSD' in data) || isNonNegativeNum(data.matchedExistingPayablesUSD)) &&
        (!('accrualPayablesUSD' in data) || isNonNegativeNum(data.accrualPayablesUSD)) &&
        (!('totalSupplierPayablesUSD' in data) || isNonNegativeNum(data.totalSupplierPayablesUSD)) &&
        (!('trialBalanceDebitUSD' in data) || isNonNegativeNum(data.trialBalanceDebitUSD)) &&
        (!('trialBalanceCreditUSD' in data) || isNonNegativeNum(data.trialBalanceCreditUSD)) &&
        data.controlsVerified is bool &&
        (!('systemUserReferences' in data) || (data.systemUserReferences is list && data.systemUserReferences.size() <= 200 && (data.systemUserReferences.size() == 0 || data.systemUserReferences[0] is map))) &&
        (!('alreadyCreatedInTargetCount' in data) || isNonNegativeNum(data.alreadyCreatedInTargetCount)) &&
        (!('constraintsCount' in data) || isNonNegativeNum(data.constraintsCount)) &&
        (!('hasLiabilityBalancesTable' in data) || data.hasLiabilityBalancesTable is bool) &&
        (!('hasPayableLedgerTable' in data) || data.hasPayableLedgerTable is bool) &&
        (!('failedKeys' in data) || (data.failedKeys is list && data.failedKeys.size() <= 500 && (data.failedKeys.size() == 0 || data.failedKeys[0] is string))) &&
        (!('lastError' in data) || isOptionalStr(data.lastError, 500)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.adminUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMigrationRunRecord(data, runId) {
      return data.keys().hasAll([
          'importRunId', 'category', 'sourceKey', 'displayLabel',
          'outcome', 'ownerUid', 'adminUids', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'importRunId', 'category', 'sourceKey', 'displayLabel',
          'outcome', 'targetCollection', 'targetDocId', 'errorMessage',
          'ownerUid', 'adminUids', 'updatedAt'
        ]) &&
        data.importRunId == runId &&
        isValidId(data.importRunId) &&
        data.category in ['customer', 'supplier', 'account', 'pending_job', 'receivable', 'customer_credit', 'supplier_payable'] &&
        isNonEmptyStr(data.sourceKey, 160) &&
        isNonEmptyStr(data.displayLabel, 200) &&
        data.outcome in ['created', 'matched', 'skipped', 'failed'] &&
        (!('targetCollection' in data) || isOptionalStr(data.targetCollection, 64)) &&
        (!('targetDocId' in data) || isOptionalStr(data.targetDocId, 128)) &&
        (!('errorMessage' in data) || isOptionalStr(data.errorMessage, 500)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.adminUids) &&
        data.updatedAt is timestamp;
    }

    function isValidMigrationReferenceTable(data, runId) {
      return data.keys().hasAll([
          'tableName', 'headers', 'rows', 'rowCount',
          'importRunId', 'ownerUid', 'adminUids', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'tableName', 'headers', 'rows', 'rowCount',
          'importRunId', 'ownerUid', 'adminUids', 'createdAt'
        ]) &&
        data.importRunId == runId &&
        isValidId(data.importRunId) &&
        data.tableName in ['liabilityBalances', 'payableLedger'] &&
        data.headers is list && data.headers.size() <= 40 && (data.headers.size() == 0 || data.headers[0] is string) &&
        data.rows is list && data.rows.size() <= 500 && (data.rows.size() == 0 || data.rows[0] is map) &&
        isNonNegativeNum(data.rowCount) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.adminUids) &&
        data.createdAt is timestamp;
    }

    function isValidJob(data) {
      return data.keys().hasAll([
          'jobNumber', 'clientId', 'clientName', 'title', 'category', 'status', 'priority',
          'quantity', 'pricingMode', 'vatTreatment', 'vatRate', 'netTotal', 'vatAmount',
          'grossTotal', 'actualCostTotal', 'ownerUid', 'staffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'jobNumber', 'clientId', 'clientName', 'title', 'category', 'status', 'priority',
          'dueDate', 'printMethod', 'substrateOrFabric', 'colorSpecs', 'quantity',
          'sizeBreakdown', 'artworkNotes', 'tailoringMeasurements', 'checklist',
          'pricingMode', 'vatTreatment', 'vatRate', 'unitPrice', 'netTotal', 'vatAmount',
          'grossTotal', 'estimatedMaterialCost', 'estimatedLaborCost',
          'estimatedSubcontractCost', 'estimatedOverheadCost', 'actualCostTotal',
          'assignedSalesUid', 'assignedSalesName', 'assignedProductionName',
          'commissionRatePct', 'commissionBasis', 'commissionAmount',
          'commissionStatus', 'commissionPaidDate',
          'legacySourceReference', 'legacySourceStatus', 'legacyDivision',
          'legacyPreparedBy', 'legacySalesOwner', 'legacyValueUSD',
          'legacyLinesExtracted', 'importRunId',
          'ownerUid', 'staffUids', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.jobNumber, 40) &&
        isValidId(data.clientId) &&
        isNonEmptyStr(data.clientName, 160) &&
        isNonEmptyStr(data.title, 200) &&
        data.category in ['Printing', 'Branding', 'Corporate Wear', 'Tailoring'] &&
        data.status in ['Quoted', 'Approved', 'In Production', 'Quality Control', 'Ready for Dispatch', 'Delivered', 'Completed', 'Cancelled'] &&
        data.priority in ['Standard', 'Urgent', 'Express'] &&
        (!('dueDate' in data) || isOptionalStr(data.dueDate, 32)) &&
        (!('printMethod' in data) || isOptionalStr(data.printMethod, 120)) &&
        (!('substrateOrFabric' in data) || isOptionalStr(data.substrateOrFabric, 160)) &&
        (!('colorSpecs' in data) || isOptionalStr(data.colorSpecs, 160)) &&
        ((data.quantity is number && data.quantity >= 1) || ('legacyLinesExtracted' in data && data.legacyLinesExtracted == false && data.quantity == 0)) &&
        (!('sizeBreakdown' in data) || data.sizeBreakdown is map) &&
        (!('artworkNotes' in data) || isOptionalStr(data.artworkNotes, 2000)) &&
        (!('tailoringMeasurements' in data) || isOptionalStr(data.tailoringMeasurements, 2000)) &&
        (!('checklist' in data) || data.checklist is map) &&
        data.pricingMode in ['exclusive', 'inclusive'] &&
        (data.vatTreatment in ['standard', 'zero', 'exempt'] || ('legacyLinesExtracted' in data && data.legacyLinesExtracted == false && data.vatTreatment == 'unknown')) &&
        data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 50 &&
        (!('unitPrice' in data) || isNonNegativeNum(data.unitPrice)) &&
        isNonNegativeNum(data.netTotal) &&
        isNonNegativeNum(data.vatAmount) &&
        isNonNegativeNum(data.grossTotal) &&
        (!('estimatedMaterialCost' in data) || isNonNegativeNum(data.estimatedMaterialCost)) &&
        (!('estimatedLaborCost' in data) || isNonNegativeNum(data.estimatedLaborCost)) &&
        (!('estimatedSubcontractCost' in data) || isNonNegativeNum(data.estimatedSubcontractCost)) &&
        (!('estimatedOverheadCost' in data) || isNonNegativeNum(data.estimatedOverheadCost)) &&
        isNonNegativeNum(data.actualCostTotal) &&
        (!('assignedSalesUid' in data) || isOptionalStr(data.assignedSalesUid, 128)) &&
        (!('assignedSalesName' in data) || isOptionalStr(data.assignedSalesName, 120)) &&
        (!('assignedProductionName' in data) || isOptionalStr(data.assignedProductionName, 120)) &&
        (!('commissionRatePct' in data) || (data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 50)) &&
        (!('commissionBasis' in data) || data.commissionBasis in ['net_sales', 'gross_profit']) &&
        (!('commissionAmount' in data) || isNonNegativeNum(data.commissionAmount)) &&
        (!('commissionStatus' in data) || data.commissionStatus in ['Pending', 'Earned', 'Approved', 'Paid']) &&
        (!('commissionPaidDate' in data) || isOptionalStr(data.commissionPaidDate, 32)) &&
        (!('legacySourceReference' in data) || isOptionalStr(data.legacySourceReference, 120)) &&
        (!('legacySourceStatus' in data) || isOptionalStr(data.legacySourceStatus, 80)) &&
        (!('legacyDivision' in data) || isOptionalStr(data.legacyDivision, 120)) &&
        (!('legacyPreparedBy' in data) || isOptionalStr(data.legacyPreparedBy, 120)) &&
        (!('legacySalesOwner' in data) || isOptionalStr(data.legacySalesOwner, 120)) &&
        (!('legacyValueUSD' in data) || isNonNegativeNum(data.legacyValueUSD)) &&
        (!('legacyLinesExtracted' in data) || data.legacyLinesExtracted is bool) &&
        (!('importRunId' in data) || isOptionalStr(data.importRunId, 128)) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.staffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidJobCost(data, jobId) {
      return data.keys().hasAll(['jobId', 'costType', 'description', 'quantity', 'unitCost', 'totalCost', 'loggedByName', 'ownerUid', 'staffUids', 'createdAt']) &&
        data.keys().hasOnly(['jobId', 'costType', 'description', 'quantity', 'unitCost', 'totalCost', 'loggedByName', 'ownerUid', 'staffUids', 'createdAt']) &&
        data.jobId == jobId &&
        isValidId(data.jobId) &&
        data.costType in ['Material', 'Labor', 'Subcontract', 'Overhead'] &&
        isNonEmptyStr(data.description, 240) &&
        data.quantity is number && data.quantity > 0 &&
        isNonNegativeNum(data.unitCost) &&
        isNonNegativeNum(data.totalCost) &&
        isNonEmptyStr(data.loggedByName, 120) &&
        isValidId(data.ownerUid) &&
        isBoundedUidList(data.staffUids) &&
        data.createdAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'invoiceNumber', 'clientId', 'clientName', 'issueDate', 'dueDate', 'status',
          'pricingMode', 'vatRate', 'lines', 'netAmount', 'vatAmount', 'grossAmount',
          'amountPaid', 'balanceDue', 'ownerUid', 'staffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'invoiceNumber', 'jobId', 'jobNumber', 'clientId', 'clientName', 'clientVatPin',
          'clientTin', 'clientVatReg', 'issueDate', 'dueDate', 'status', 'pricingMode',
          'vatRate', 'lines', 'standardNetAmount', 'zeroRatedAmount', 'exemptAmount',
          'netAmount', 'vatAmount', 'grossAmount', 'whtRate', 'whtWithheldAmount',
          'whtCertificateRef', 'amountPaid', 'balanceDue', 'paymentMethod',
          'paymentReference', 'notes', 'ownerUid', 'staffUids', 'isVatReportable',
          'vatViewerUids', 'createdAt', 'updatedAt'
        ]) &&
        isNonEmptyStr(data.invoiceNumber, 40) &&
        (!('jobId' in data) || isOptionalStr(data.jobId, 128)) &&
        (!('jobNumber' in data) || isOptionalStr(data.jobNumber, 40)) &&
        isValidId(data.clientId) &&
        isNonEmptyStr(data.clientName, 160) &&
        (!('clientVatPin' in data) || isOptionalStr(data.clientVatPin, 64)) &&
        (!('clientTin' in data) || isOptionalStr(data.clientTin, 64)) &&
        (!('clientVatReg' in data) || isOptionalStr(data.clientVatReg, 64)) &&
        isNonEmptyStr(data.issueDate, 32) &&
        isNonEmptyStr(data.dueDate, 32) &&
        data.status in ['Draft', 'Issued', 'Part Paid', 'Paid', 'Overdue', 'Void'] &&
        data.pricingMode in ['exclusive', 'inclusive'] &&
